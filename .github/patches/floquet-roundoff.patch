   return true
 end
 
+function reconstructed_map_scale(canonical::Liouvillian, dissipative::Liouvillian)
+  scale = 0.0
+  for generator in (canonical, dissipative), entry in term_pairs(generator)
+    for (magnitude, _) in monomial_constants(last(entry))
+      scale = max(scale, magnitude)
+    end
+  end
+  return scale
+end
+
 function drop_floating_roundoff(
   residual::Liouvillian,
   canonical::Liouvillian,
@@ -235,7 +245,13 @@ function drop_floating_roundoff(
       get(dissipative.terms, action, zero(SQA.CNum)),
     )
     two_sided = !qadd_isone(left) && !qadd_isone(right)
-    floor = two_sided ? matrix_scale : 0.0
+    floor = if two_sided
+      matrix_scale
+    elseif qadd_isone(left) && qadd_isone(right)
+      reconstructed_map_scale(canonical, dissipative)
+    else
+      0.0
+    end
     floating_roundoff(coefficient, reference, floor) && continue
     add_term!(result, left, right, coefficient)
   end
