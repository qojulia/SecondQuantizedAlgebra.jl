+
+@testset "identity residual roundoff uses reconstructed map units" begin
+  identity_action(c) = Liouvillian(Dict((one(a), one(a)) => convert(SQA.CNum, c)))
+  error_message = "Liouvillian residual is not a Hamiltonian commutator"
+  for scale in (1.0, 1.0e-12, 1.0e12)
+    L = (0.2 * scale) * dissipator(a)
+    noisy = L + identity_action(-8.673617379884036e-20im * scale)
+    for normalization in (1.0, 1.0e-6)
+      frame = DissipativeFrame(normalization * a)
+      @test iszero(hamiltonian(noisy, frame))
+      rate = Symbolics.value(real(SQA.to_num(kossakowski(noisy, frame)[1, 1])))
+      @test rate ≈ 0.2 * scale / normalization^2
+      invalid = L + identity_action(1.0e-4im * scale)
+      @test_throws error_message hamiltonian(invalid, frame)
+    end
+  end
+  frame = DissipativeFrame(a)
+  @test_throws error_message hamiltonian(identity_action(1.0e-20im), frame)
+  exact = dissipator(a) + identity_action((1 // 10^12) * im)
+  @test_throws error_message hamiltonian(exact, frame)
+end
